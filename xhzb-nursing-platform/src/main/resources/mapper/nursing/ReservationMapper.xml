<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xhzb.nursing.mapper.ReservationMapper">

    <resultMap type="Reservation" id="ReservationResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="mobile"    column="mobile"    />
        <result property="time"    column="time"    />
        <result property="visitor"    column="visitor"    />
        <result property="type"    column="type"    />
        <result property="status"    column="status"    />
        <result property="arriveTime"    column="arrive_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectReservationVo">
        select id, name, mobile, time, visitor, type, status, arrive_time, create_by, update_by, remark, create_time, update_time from reservation
    </sql>

    <select id="selectReservationList" parameterType="Reservation" resultMap="ReservationResult">
        <include refid="selectReservationVo"/>
        <where>
            <if test="createBy != null and createBy != ''"> and create_by = #{createBy}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="mobile != null  and mobile != ''"> and mobile = #{mobile}</if>
            <if test="visitor != null  and visitor != ''"> and visitor like concat('%', #{visitor}, '%')</if>
            <if test="type != null "> and type = #{type}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
        order by time desc
    </select>

    <select id="selectTimeCountList" resultType="com.xhzb.nursing.domain.vo.ReservationTimeCountVo">
        select time as time, #{capacity} - count(1) as count
        from reservation
        where type = #{type} and status != #{cancelStatus}
        and time &gt;= #{startTime} and time &lt; #{endTime}
        group by time
        having #{capacity} - count(1) &gt;= 0
        order by time
    </select>
</mapper>
